      "mainEntity": [
        {
          "@type": "Question",
          "name": "Can you coordinate with our internal team?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The proposal can establish a division of responsibilities with your team. Before work starts, the engagement identifies who prepares information, who reviews it and who authorizes the relevant actions."
          }
        },
        {
          "@type": "Question",
          "name": "Are tax returns included?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Included obligations and tax returns must be expressly identified in the proposal. The scope depends on your business activities, tax position and requirements."
          }
        },
        {
          "@type": "Question",
          "name": "Which documents do we need to begin?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Your needs are reviewed first. Relevant information is then requested, which may include accounting records, reports and tax documents. Please do not send confidential documents through the initial contact form."
          }
        },
        {
          "@type": "Question",
          "name": "Can you review previous periods?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "You can request an assessment of that requirement. Document availability and the number of periods involved determine whether a separate scope and proposal are needed."
          }
        },
        {
          "@type": "Question",
          "name": "How are fees determined?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Fees reflect the volume of activity, the obligations included and the condition of available information. The proposal should explain what the service covers and which additional tasks are quoted separately."
          }
        }
      ]
