      },
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Does the problem need to be fully defined before we contact you?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Describe the decision you face or the situation that concerns you. The initial conversation helps clarify the need and assess whether an engagement would be appropriate."
          }
        },
        {
          "@type": "Question",
          "name": "Does consulting include implementing recommendations?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Only where expressly agreed. A proposal should distinguish analysis, recommendations and implementation support, with responsibilities and deliverables for each contracted component."
          }
        },
        {
          "@type": "Question",
          "name": "Can you work with our existing information?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Available information is reviewed when the scope is defined. Where relevant data is missing, the limitations and information needed before drawing conclusions should be identified."
          }
        },
        {
          "@type": "Question",
          "name": "How long does a project take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "This depends on the question, information availability and the people involved. A schedule is defined in the proposal. No standard turnaround is offered without understanding the specific circumstances."
          }
        },
        {
          "@type": "Question",
          "name": "Does consulting guarantee higher profits?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. The service provides information and analysis to support decisions. Results depend on execution, market conditions and other business factors that should be considered when evaluating recommendations."
          }
        }
      ]
    },
