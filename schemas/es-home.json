      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Pueden trabajar con una empresa que ya tiene contador?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí puede solicitar una conversación para revisar una necesidad específica de asesoría o auditoría. El alcance y la coordinación con su equipo se definen antes de contratar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué servicio necesita mi empresa?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depende de la decisión o dificultad que necesita resolver. Comparta su situación y el servicio que considera relevante; la consulta permite revisar el alcance adecuado."
          }
        },
        {
          "@type": "Question",
          "name": "¿Dónde se encuentra la firma?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En San Pedro Garza García, Nuevo León, dentro del área metropolitana de Monterrey. Encontrará la dirección completa al final de esta página."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuánto cuestan sus servicios?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Los honorarios dependen del servicio, el alcance y la información de su empresa. Solicite una consulta para revisar su necesidad y conocer las condiciones de una propuesta."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cómo puedo solicitar una consulta?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Complete el formulario con su nombre, empresa, teléfono y servicio de interés. También puede comunicarse por teléfono o WhatsApp. La cita queda sujeta a confirmación."
          }
        }
