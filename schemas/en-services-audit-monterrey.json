      "mainEntity": [
        {
          "@type": "Question",
          "name": "Does an audit examine every transaction?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not necessarily. The nature and extent of procedures depend on the engagement type and applicable standards. The scope must be clearly understood before work begins."
          }
        },
        {
          "@type": "Question",
          "name": "Can you audit a company whose accounting is handled by another firm?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "You can request an engagement assessment. The firm must consider independence requirements, information availability and the coordination needed with those responsible for the records."
          }
        },
        {
          "@type": "Question",
          "name": "Can the report be used by a bank or investor?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "That depends on the recipient’s requirements. Share those requirements before commissioning the work so the required report type and the firm’s ability to undertake it can be confirmed."
          }
        },
        {
          "@type": "Question",
          "name": "Does an audit guarantee that every irregularity will be detected?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Every review has objectives, a scope and limitations. It should not be presented as an absolute guarantee that errors or irregularities are absent, or as a promise of a favorable opinion."
          }
        },
        {
          "@type": "Question",
          "name": "What does our business need to get started?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A description of the requirement, the period concerned and the recipient’s conditions. The appropriate financial information and supporting documentation can then be specified."
          }
        }
      ]
    },
