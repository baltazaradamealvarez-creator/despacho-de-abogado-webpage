      },
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Pueden coordinarse con nuestro equipo interno?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La propuesta puede contemplar una distribución de responsabilidades con su equipo. Antes de iniciar se define quién prepara la información, quién la revisa y quién autoriza las acciones correspondientes."
          }
        },
        {
          "@type": "Question",
          "name": "¿Incluye declaraciones de impuestos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Las obligaciones y declaraciones incluidas deben quedar expresamente identificadas en la propuesta. El alcance depende de la actividad, situación fiscal y necesidades de su empresa."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué documentos necesito para empezar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Primero se revisa su necesidad. Después se solicita la información pertinente, que puede incluir registros contables, reportes y documentación fiscal. No envíe información confidencial por el formulario inicial."
          }
        },
        {
          "@type": "Question",
          "name": "¿Pueden revisar periodos anteriores?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Puede solicitar una evaluación de esa necesidad. La disponibilidad de documentos y la extensión de los periodos determinarán si se requiere un alcance adicional y una propuesta específica."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cómo se determinan los honorarios?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Se consideran el volumen de operación, las obligaciones incluidas y el estado de la información. La propuesta debe indicar qué cubre el servicio y qué trabajos se cotizan por separado."
          }
        }
      ]
    },
