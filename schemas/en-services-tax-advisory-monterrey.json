      "mainEntity": [
        {
          "@type": "Question",
          "name": "Does tax advisory guarantee lower taxes?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Advisory work evaluates obligations, alternatives and risks within the law. Outcomes depend on your business facts and the applicable rules. No specific tax saving is promised."
          }
        },
        {
          "@type": "Question",
          "name": "Can we discuss a transaction before carrying it out?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "You can bring a proposed transaction to the consultation. An early review helps identify missing information and tax considerations that should be understood before a decision is made."
          }
        },
        {
          "@type": "Question",
          "name": "Is this the same as accounting?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Accounting records and organizes recurring information. Tax advisory examines specific questions or decisions. The two services can complement each other where the engagement requires it."
          }
        },
        {
          "@type": "Question",
          "name": "What if we receive a notice from a tax authority?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "State the document type and date received when requesting contact, without attaching sensitive data. The firm must assess the matter and confirm whether it can assist, under what scope and within which timeframe."
          }
        },
        {
          "@type": "Question",
          "name": "Will we receive a written opinion?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Deliverable formats and scope should be agreed in the proposal. An initial conversation does not replace a documented assessment or constitute a professional conclusion about your case."
          }
        }
      ]
    },
