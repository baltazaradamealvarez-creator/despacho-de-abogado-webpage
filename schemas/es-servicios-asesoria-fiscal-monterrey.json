    {
      "@type": "FAQPage",
      "@id": "https://gonzalezarmendariz.com/servicios/asesoria-fiscal-monterrey/#faq",
      "inLanguage": "es-MX",
      "isPartOf": {
        "@id": "https://gonzalezarmendariz.com/servicios/asesoria-fiscal-monterrey/#webpage"
      },
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿La asesoría garantiza pagar menos impuestos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. La asesoría evalúa obligaciones, alternativas y riesgos conforme a la ley. El resultado depende de los hechos de su empresa y de las disposiciones aplicables; no se promete un ahorro determinado."
          }
        },
        {
          "@type": "Question",
          "name": "¿Puedo consultar una operación antes de realizarla?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí puede plantear la operación que está considerando. Revisarla con anticipación permite identificar información faltante y aspectos fiscales que conviene entender antes de decidir."
          }
        },
        {
          "@type": "Question",
          "name": "¿Es lo mismo que llevar la contabilidad?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. La contabilidad registra y organiza información recurrente. La asesoría fiscal analiza preguntas o decisiones concretas. Ambos servicios pueden complementarse cuando la necesidad lo requiere."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué sucede si recibimos una comunicación de la autoridad?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Indique el tipo de documento y la fecha de recepción al solicitar contacto, sin adjuntar datos sensibles. La firma deberá evaluar el asunto y confirmar si puede atenderlo, con qué alcance y en qué tiempos."
          }
        },
        {
          "@type": "Question",
          "name": "¿La consulta incluye una opinión por escrito?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El formato y alcance de los entregables deben acordarse en la propuesta. Una conversación inicial no sustituye un análisis documentado ni implica una conclusión profesional sobre su caso."
          }
        }
      ]
    },
